{
  "version": 2,
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://aijobs1.in",
    "VITE_SITE_URL": "https://aijobs1.in",
    "APP_URL": "https://aijobs1.in",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "auth.aijobs1.in"
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/job-sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/jobs/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
