{
  "version": 2,
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://aijobs1.in",
    "VITE_SITE_URL": "https://aijobs1.in",
    "APP_URL": "https://aijobs1.in",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "auth.aijobs1.in",
    "INFO_EMAIL": "info@aijobs1.in",
    "SALES_EMAIL": "salesindia@aijobs1.in",
    "COMPLIANCE_EMAIL": "compliant@aijobs1.in",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "info@aijobs1.in",
    "SMTP_INFO_USER": "info@aijobs1.in",
    "SMTP_SALES_USER": "salesindia@aijobs1.in",
    "SMTP_COMPLIANCE_USER": "compliant@aijobs1.in",
    "EMAIL_FROM_ADDRESS": "info@aijobs1.in",
    "EMAIL_FROM_NAME": "AIJOBS",
    "EMAIL_INFO_FROM_NAME": "AIJOBS Support",
    "EMAIL_SALES_FROM_NAME": "AIJOBS Sales India",
    "EMAIL_COMPLIANCE_FROM_NAME": "AIJOBS Compliance"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.aijobs1.in" }
      ],
      "destination": "https://aijobs1.in/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/hire.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/hire", "destination": "/hire.html" },
    { "source": "/hire/workspace", "destination": "/hire-workspace.html" },
    { "source": "/hire/:role", "destination": "/hire.html" },
    { "source": "/admin/jobs/verification", "destination": "/hire-admin.html" },
    { "source": "/admin/marketing/recruiter-acquisition", "destination": "/hire-admin.html" },
    { "source": "/sitemap.xml", "destination": "/api/index" },
    { "source": "/job-sitemap.xml", "destination": "/api/index" },
    { "source": "/robots.txt", "destination": "/api/index" },
    { "source": "/jobs/:path*", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|hire\\.html$|hire-admin\\.html$|hire-workspace\\.html$|firebase-applet-config\\.json$|ads\\.txt$|robots\\.txt$|sitemap\\.xml$|job-sitemap\\.xml$).*)", "destination": "/index.html" }
  ]
}
