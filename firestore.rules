rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'admin' || 
        getUserRole() == 'superadmin' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isCandidate() {
      return isSignedIn() && getUserRole() == 'candidate';
    }

    function isRecruiter() {
      return isSignedIn() && (
        getUserRole() == 'employer' || 
        getUserRole() == 'recruiter' || 
        getUserRole() == 'corporate'
      );
    }

    function isConsultancy() {
      return isSignedIn() && (
        getUserRole() == 'consultancy' || 
        getUserRole() == 'agency'
      );
    }

    // Collection Rules

    // Users Profiles Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        (!('role' in request.resource.data) || !(request.resource.data.role in ['admin', 'superadmin', 'super_admin'])) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false);
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isSuperAdmin', 'isApproved', 'isActive', 'status', 'accountStatus', 'kycStatus', 'adminLevel', 'approvedBy', 'approvedAt'])
      );
      allow delete: if isAdmin();

      match /email_preferences/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Firebase Trigger Email extension collection - ONLY ADMIN / SERVER can write to mail
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    // Email Campaign Deliveries
    match /email_campaign_deliveries/{deliveryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Candidates & Candidate Profiles Collection
    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow write: if isOwner(candidateId) || isRecruiter() || isConsultancy() || isAdmin();
    }
    match /candidate_profiles/{profileId} {
      allow read: if isSignedIn();
      allow write: if isOwner(profileId) || isRecruiter() || isConsultancy() || isAdmin();
    }
    
    // Recruiter Profiles Collection
    match /recruiter_profiles/{profileId} {
      allow read: if isSignedIn();
      allow write: if isOwner(profileId) || isRecruiter() || isAdmin();
    }

    // Consultancies collection
    match /consultancies/{consultancyId} {
      allow read: if isSignedIn();
      allow write: if isOwner(consultancyId) || (isSignedIn() && resource.data.userId == request.auth.uid) || isConsultancy() || isAdmin();
    }
    
    // Employers collection
    match /employers/{employerId} {
      allow read: if isSignedIn();
      allow write: if isOwner(employerId) || (isSignedIn() && resource.data.userId == request.auth.uid) || isRecruiter() || isAdmin();
    }
    
    // Companies collection
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Jobs postings - visible to public/guests, writeable by recruiters/consultancies/admins
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && (isRecruiter() || isConsultancy() || isAdmin());
      allow update, delete: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isOwner(resource.data.recruiterId) || 
        isOwner(resource.data.employerId) || 
        isAdmin()
      );
    }
    match /company_jobs/{jobId} {
      allow read: if true;
      allow write: if isSignedIn() && (isRecruiter() || isAdmin());
    }
    
    // Applications
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.candidateId) || 
        isOwner(resource.data.userId) || 
        isOwner(resource.data.recruiterId) || 
        isOwner(resource.data.employerId) || 
        isRecruiter() || 
        isConsultancy() || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isOwner(resource.data.candidateId) || 
        isOwner(resource.data.recruiterId) || 
        isOwner(resource.data.employerId) || 
        isAdmin()
      );
    }
    match /company_applications/{applicationId} {
      allow read, write: if isSignedIn();
    }
    
    // Saved Jobs Collection
    match /saved_jobs/{savedId} {
      allow read, write: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        request.resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }
    
    // Resumes and Resume Versions
    match /resumes/{resumeId} {
      allow read, write: if isSignedIn();
    }
    match /resume_versions/{versionId} {
      allow read, write: if isSignedIn();
    }
    match /resume_analysis/{analysisId} {
      allow read, write: if isSignedIn();
    }
    match /resume_scores/{scoreId} {
      allow read, write: if isSignedIn();
    }
    match /resume_recommendations/{recommendationId} {
      allow read, write: if isSignedIn();
    }
    
    // Interviews and scheduled sessions
    match /interviews/{interviewId} {
      allow read, write: if isSignedIn();
    }
    match /company_interviews/{interviewId} {
      allow read, write: if isSignedIn();
    }
    match /interviews_scheduled/{interviewId} {
      allow read, write: if isSignedIn();
    }
    match /interview_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }
    match /interview_reports/{reportId} {
      allow read, write: if isSignedIn();
    }
    match /interview_questions/{questionId} {
      allow read, write: if isSignedIn();
    }
    match /interview_answers/{answerId} {
      allow read, write: if isSignedIn();
    }
    match /ai_reports/{reportId} {
      allow read, write: if isSignedIn();
    }
    match /ai_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }
    match /ai_prompts/{promptId} {
      allow read, write: if isSignedIn();
    }
    match /career_reports/{careerId} {
      allow read, write: if isSignedIn();
    }
    match /job_recommendations/{recId} {
      allow read, write: if isSignedIn();
    }
    
    // Notifications and logs
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow write: if isSignedIn();
    }
    match /notification_preferences/{userId} {
      allow read, write: if isSignedIn();
    }
    match /activity_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /submission_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /candidate_documents/{docId} {
      allow read, write: if isSignedIn();
    }
    match /company_activity_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /login_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    
    // Support and settings
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
    match /support/{ticketId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Admin list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Leads Collection
    match /leads/{leadId} {
      allow read, write: if isSignedIn();
    }
    
    // Approvals Collection
    match /approvals/{approvalId} {
      allow read, write: if isSignedIn();
    }
    
    // Payments & Subscriptions
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }
    match /subscriptions/{subscriptionId} {
      allow read, write: if isSignedIn();
    }
    
    // CMS Contents
    match /cms/{cmsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Email Templates
    match /email_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    
    // Social links
    match /social_links/{linkId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Clients
    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }
    
    // Consultancy Jobs & Candidates
    match /consultancy_jobs/{jobId} {
      allow read, write: if isSignedIn();
    }
    match /consultancy_candidates/{candidateId} {
      allow read, write: if isSignedIn();
    }
    
    // Placements & Team Members
    match /placements/{placementId} {
      allow read, write: if isSignedIn();
    }
    match /team_members/{memberId} {
      allow read, write: if isSignedIn();
    }
    
    // Message logs, Offers
    match /message_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /offers/{offerId} {
      allow read, write: if isSignedIn();
    }
    
    // Chats and nested Messages
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
    
    // Career goals, predictions, cover letters, learning paths
    match /career_goals/{goalId} {
      allow read, write: if isSignedIn();
    }
    match /success_predictions/{predId} {
      allow read, write: if isSignedIn();
    }
    match /cover_letters/{letterId} {
      allow read, write: if isSignedIn();
    }
    match /resume_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /learning_paths/{pathId} {
      allow read, write: if isSignedIn();
    }
    
    // FAQs & Blogs
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Fraud Alerts
    match /fraud_alerts/{alertId} {
      allow read, write: if isSignedIn();
    }

    // Verification Requests
    match /verification_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // Chat messages & sessions
    match /chat_messages/{messageId} {
      allow read, write: if isSignedIn();
    }
    match /chat_sessions/{sessionId} {
      allow read, write: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
    match /ai_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    // AI scoring & matching
    match /interview_scores/{scoreId} {
      allow read, write: if isSignedIn();
    }
    match /talent_scores/{scoreId} {
      allow read, write: if isSignedIn();
    }
    match /ai_recommendations/{recId} {
      allow read, write: if isSignedIn();
    }
    match /job_matches/{matchId} {
      allow read, write: if isSignedIn();
    }
    match /candidate_selfies/{selfieId} {
      allow read, write: if isSignedIn();
    }
    match /admin_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /indexing_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /billing_profiles/{profileId} {
      allow read, write: if isSignedIn();
    }
    match /bookmarks/{bookmarkId} {
      allow read, write: if isSignedIn();
    }
    match /career_applications/{appId} {
      allow read, write: if isSignedIn();
    }
    match /career_guidance/{guidanceId} {
      allow read, write: if isSignedIn();
    }
    match /company_info/{infoId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /global_config/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /global_socials/{socialId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /prompt_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /recruiters/{recruiterId} {
      allow read: if isSignedIn();
      allow write: if isOwner(recruiterId) || isRecruiter() || isAdmin();
    }
    match /referrals/{referralId} {
      allow read, write: if isSignedIn();
    }
  }
}
